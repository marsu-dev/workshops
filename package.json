{
    "name": "workshops-revealjs",
    "version": "1.0.0",
    "description": "Présentations Reveal.js pour GitHub Pages",
    "main": "index.html",
    "scripts": {
        "start": "live-server --port=8080 --open=/index.html --watch=.",
        "build": "echo 'No build step required for static site'",
        "deploy": "gh-pages -d .",
        "generate-pdf": "node generate-pdf.js",
        "generate-pdf:all": "node generate-pdf.js",
        "generate-pdf:handout": "node generate-pdf.js --handout",
        "generate-pdf:handout:all": "node generate-pdf.js --handout"
    },
    "keywords": [
        "reveal.js",
        "presentations",
        "markdown"
    ],
    "author": "",
    "license": "AGPL-3.0",
    "devDependencies": {
        "gh-pages": "^6.1.0",
        "live-server": "^1.2.2"
    },
    "dependencies": {
        "reveal.js": "^5.0.4"
    }
}